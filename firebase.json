{
  "firestore": {"rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json"},
  "hosting": {
    "public": "experiment_09_firebase_database/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [{"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]
  },
  "emulators": {
    "auth": {"host": "127.0.0.1", "port": 9099},
    "firestore": {"host": "127.0.0.1", "port": 8081},
    "ui": {"enabled": true, "host": "127.0.0.1", "port": 4000},
    "singleProjectMode": true
  }
}
